# Firebase istemci ayarları
VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":"","measurementId":""}
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK sunucu ayarları (yalnızca Vercel/cihaz ortamında)
FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Ek Google e-posta + cihaz geçişi v2 güvenlik modu.
# V1 tek tarayıcı / tek yeni kayıt koruması bu ayarlardan bağımsız da etkindir.
# V2 için Firebase Google sign-in ve Google Form doğrulanmış e-posta ayarlarını yapın.
VITE_SGM_NEW_REGISTRATION_GUARD_ENABLED=false
SGM_NEW_REGISTRATION_GUARD_ENABLED=false
